{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-05",
	"name": "shopping-list2-worker",
	"main": "src/index.ts",	
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "shopping_list",
			"database_name": "shopping-list",
			"database_id": "b6a05ec8-bfab-45b0-bbcd-2fd3c27a9628"
		}
	],
	"vars": {
		"SUPABASE_URL": "https://isdtokzfuppyibdyevtu.supabase.co",
		"SUPABASE_BUCKET": "white-stone-userimg"
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
